# amp-server — matchmaker configuration
# Copy to amp-server/.env and fill in. All optional except DATABASE_URL.

# Postgres (Neon pooled connection string). Shared with web/ and relayer/.
DATABASE_URL=

# Bind address for the HTTP + WS API.
AMP_BIND=0.0.0.0:8080

# Public site name shown inside the wallet's sign-in message (helps players
# recognize the signature as legitimate, not a drainer prompt).
AMP_SITE_NAME=AMP Arena

# CORS origins, comma-separated. "*" allows any (fine for beta).
AMP_CORS_ORIGINS=*

# EIP-712 verifier key (32-byte hex). Signs match-outcome attestations.
# ABSENT  -> free-play mode: matchmaking + ratings work, no attestations,
#            staking disabled.
# PRESENT -> attestations on every settled match + (with AMP_STAKING_ENABLED)
#            staked-match settlement via AMPSettlement.
AMP_VERIFIER_KEY=

# Chain + contract context for attestations. Defaults: Fuji testnet.
AMP_CHAIN_ID=43113
AMP_SETTLEMENT_ADDRESS=

# Enable staked queues (requires AMP_VERIFIER_KEY + deployed settlement).
AMP_STAKING_ENABLED=0

# Session lifetime for logged-in players (hours). Default: 1 week.
AMP_SESSION_TTL_HOURS=168

# Live-match lifetime before the expiry sweep reconciles it (minutes).
AMP_MATCH_TTL_MINUTES=120

# Matchmaker tick cadence (ms). Lower = faster pairing, more CPU.
AMP_TICK_MS=100

# Skill window: base MMR gap, growth per second of wait, hard cap.
AMP_SKILL_WINDOW_BASE=350
AMP_SKILL_WINDOW_EXPANSION_PER_SEC=8
AMP_SKILL_WINDOW_CAP=1200

# Cap on concurrently live matches.
AMP_MAX_ACTIVE_MATCHES=10000

# Admin token for the /v1/admin arbitration API. unset = admin API disabled.
AMP_ADMIN_TOKEN=

# --- Cold-start mechanics ----------------------------------------------------

# Practice-bot fill: after this much queue wait (ms), the house opponent
# offers an instant unrated match so nobody bounces off an empty lobby.
# 0/false disables.
AMP_BOT_FILL_ENABLED=1
AMP_BOT_AFTER_MS=45000

# House opponent identity (defaults to the verifier address when set).
# AMP_HOUSE_WALLET=

# Scheduled prime-time queue windows, UTC:
# [{"gameId":"amp-tactics","timesUtc":["18:00","21:00"]}]
# AMP_QUEUE_WINDOWS_JSON=

# Optional custom game catalog (JSON): [{"id","name","rulesets":[{"id","name"}]}]
# AMP_GAMES_JSON=

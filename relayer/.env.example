# ─── Relayer environment ──────────────────────────────────────────────
# The relayer is the ONLY process that holds the funded key. Run it as a
# persistent daemon (Fly.io / Railway / Render / VPS) — NOT on Vercel.

# Neon Postgres — same DATABASE_URL as the web. Use the POOLED connection
# string (hostname with "-pooler"); works for the relayer's persistent
# connections too.
DATABASE_URL=

# Funded Fuji EOA private key (the custody wallet). Sole holder.
AMP_RELAYER_KEY=

# Optional: tracing filter (e.g., "info", "debug", "amp_relayer=trace").
RUST_LOG=info

# ─── Network / contracts (defaults: Fuji testnet) ──────────────────────
# Every value below has a documented default; override per deployment.
# Repo standard: no network constant without an env path.

# Chain id the relayer signs for. 43113 = Fuji, 43114 = Avalanche mainnet.
AMP_CHAIN_ID=43113

# JSON-RPC endpoint (public Fuji default; use a private RPC in prod).
AMP_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# AMPTournamentCup address (sponsor prize path).
# Fuji default per contracts/deployment-fuji-tournament.json.
AMP_CUP_ADDRESS=0x7c743c1c9ae3e7a65d030098f2249b7787d66dff

# AMPSettlement address (staked-match settlement path).
# Fuji default per contracts/deployment-fuji.json.
AMP_SETTLEMENT_ADDRESS=0xc1b12a7Ffad6CeFf045064f9fE3E8879F0F3c9eD

# Job-queue poll cadence (ms): idle between empty dequeues, and error backoff.
AMP_POLL_IDLE_MS=3000
AMP_POLL_ERROR_MS=10000

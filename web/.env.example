# ─── Database (REQUIRED) ──────────────────────────────────────────────
# Neon Postgres — use the POOLED connection string (the hostname with "-pooler"
# in it, e.g. ep-xxx-pooler…neon.tech). NOT the direct endpoint — the web runs
# on Vercel serverless and will exhaust direct connections under load.
DATABASE_URL=

# ─── Matchmaker (REQUIRED for /arena) ─────────────────────────────────
# Base URL of the Rust amp-server (../amp-server). The browser talks to it
# directly for queue/login/matches (REST + WebSocket).
#
# ⚠️ NEXT_PUBLIC_* variables are INLINED INTO THE BUNDLE AT BUILD TIME.
# Setting this in your host's dashboard does nothing until you REDEPLOY.
# A production build without it silently ships http://localhost:8080 —
# the arena shows a red "Matchmaker not configured" banner when it
# detects that state.
# Deploy the server with:  fly deploy -c amp-server/fly.toml
NEXT_PUBLIC_AMP_SERVER_URL=http://localhost:8080

# ─── Rate limiting (REQUIRED for production) ──────────────────────────
# Upstash Redis — per-IP rate limits on /api/*. Without these, rate limiting
# is skipped (the app works, just unthrottled).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── PayPal (REQUIRED for card/fiat funding) ──────────────────────────
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is the same value as PAYPAL_CLIENT_ID (PayPal
# has one public Client ID per app). Without these, PayPal buttons are hidden
# and the AVAX (wallet) path still works.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ─── PayPal Webhook (REQUIRED for reliable fulfillment) ──────────────
# The Webhook ID from the PayPal dashboard (My Apps → your app → Webhooks).
# Used for signature verification on /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# ──────────────────────────────────────────────────────────────────────
# NOTE: AMP_RELAYER_KEY is NOT set here. The web never holds the funded key —
# only the isolated Rust relayer (../relayer) does. The web enqueues jobs;
# the relayer signs + submits on-chain.

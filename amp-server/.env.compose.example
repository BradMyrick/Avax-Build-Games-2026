# Copy to amp-server/.env on the host and fill in. NEVER commit the filled copy.
#   cp amp-server/.env.compose.example amp-server/.env

# REQUIRED — Postgres password for the matchmaker's database.
# Generate: openssl rand -hex 24
AMP_DB_PASSWORD=

# RECOMMENDED — EIP-712 attestation signer key (32-byte hex, no 0x needed).
# Generate: openssl rand -hex 32
# Its public address must be whitelisted as a game verifier on AMPRegistry
# (game admin) before on-chain attestations verify; free play works without.
AMP_VERIFIER_KEY=

# RECOMMENDED — arbitration API token. Generate: openssl rand -hex 24
AMP_ADMIN_TOKEN=

# v1 Fuji contracts (attestation context)
AMP_SETTLEMENT_ADDRESS=0x78ec93e66255a74873d20DD62C6595A389272126
AMP_REGISTRY_ADDRESS=0xf6B0eA6c88c574c4BbEAdC186AAfe72C43C2cDc2

# Allowed browser origins (comma-separated). * allows any (open beta).
AMP_CORS_ORIGINS=*
